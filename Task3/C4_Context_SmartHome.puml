@startuml C4_Context_SmartHome
!include <C4/C4_Context>

title C4 L1. Контекст — новые сервисы «Умный дом» для собственников (партнёрская платформа)

Person(owner, "Собственник", "пользователь мобильного приложения PropDevelopment")
Person(partnerAdmin, "Администратор платформы партнёра", "управляет устройствами и доступом")

System(smartHome, "Платформа «Умный дом» партнёра", "Внешняя платформа: интеллектуальный домофон (распознавание лиц), шлагбаум (распознавание номеров авто)")

System_Boundary(pd, "PropDevelopment") {
  System(mobileApp, "Мобильное приложение собственников", "Управление ЖКУ, «Умным домом»: домофон и шлагбаум")
  System(gateway, "smart-home-gateway", "Единая точка интеграции: аутентификация, права, аудит")
  System(crm, "CRM собственников", "Данные собственников и их объектов недвижимости")
}

Rel(owner, mobileApp, "Открывает дверь/шлагбаум, смотрит события доступа")
Rel(mobileApp, gateway, "REST, TLS 1.2+: команды и статусы устройств")
Rel(gateway, smartHome, "REST, mTLS + вебхуки: управление устройствами, события доступа")
Rel(crm, gateway, "REST: проверка прав собственника на объект")
Rel(partnerAdmin, smartHome, "Администрирует устройства и биометрические шаблоны")

SHOW_LEGEND()
@enduml
